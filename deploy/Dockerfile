# BreastVision — Production Dockerfile
# Node.js Express API + Expo web static bundle
# No M6 / Python / FastAPI — pure BreastVision only

FROM node:22-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

WORKDIR /app

# ─── 1. Install dependencies ───────────────────────────────────────────────
COPY breastvision/package.json breastvision/pnpm-lock.yaml ./
# Install ALL deps (including devDeps like esbuild) so the build step works.
# The runtime stage only copies the final artifacts — devDeps never reach prod.
RUN pnpm install --frozen-lockfile

# ─── 2. Copy source & pre-built frontend ───────────────────────────────────
# Server source files
COPY breastvision/server ./server
COPY breastvision/shared ./shared
COPY breastvision/drizzle ./drizzle

# Pre-built Expo web bundle (generated by: pnpm expo export --platform web)
COPY breastvision/dist ./dist

# Copy audited predictions lookup table
COPY MODEL_DEVELOPMENT/step8_ablation_predictions.csv ./MODEL_DEVELOPMENT/step8_ablation_predictions.csv

# ─── 3. Build the Express server bundle ────────────────────────────────────
COPY breastvision/tsconfig.json ./
RUN pnpm exec esbuild server/_core/index.ts \
      --platform=node \
      --packages=external \
      --bundle \
      --format=esm \
      --outdir=dist-server

# ─── 4. Runtime stage ──────────────────────────────────────────────────────
FROM node:22-slim AS runtime
ENV NODE_ENV=production
ENV PORT=3000
WORKDIR /app

# Only copy what's needed at runtime
COPY --from=base /app/node_modules ./node_modules
COPY --from=base /app/dist-server  ./dist-server
COPY --from=base /app/dist         ./dist
COPY --from=base /app/MODEL_DEVELOPMENT ./MODEL_DEVELOPMENT

# Health check against the Express /api/health endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD node -e "require('http').get('http://localhost:'+process.env.PORT+'/api/health', r => process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

EXPOSE 3000

CMD ["node", "dist-server/index.js"]
